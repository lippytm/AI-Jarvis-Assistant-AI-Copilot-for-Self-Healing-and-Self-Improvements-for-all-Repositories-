{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository defect resolution evidence",
  "type": "object",
  "required": [
    "repository", "commit_before", "commit_after", "finding_id", "reproducer_before",
    "reproducer_after", "tests", "rollback", "monitoring", "owner_approval"
  ],
  "properties": {
    "repository": {"type": "string", "minLength": 1},
    "commit_before": {"type": "string", "minLength": 7},
    "commit_after": {"type": "string", "minLength": 7},
    "finding_id": {"type": "string", "minLength": 1},
    "reproducer_before": {"type": "object"},
    "reproducer_after": {"type": "object"},
    "tests": {"type": "array", "minItems": 1},
    "rollback": {"type": "string", "minLength": 1},
    "monitoring": {"type": "string", "minLength": 1},
    "owner_approval": {"type": "boolean"},
    "residual_risk": {"type": "array", "items": {"type": "string"}}
  }
}
